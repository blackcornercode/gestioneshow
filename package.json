{
  "name": "gestioneshow",
  "version": "1.11.0",
  "description": "Gestione Show MCG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win portable --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "electron-store": "^11.0.2"
  },
  "build": {
    "appId": "com.gestioneshow.app",
    "productName": "Gestione Show MCG",
    "artifactName": "GestioneShowMCG-${version}-portable.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "style.css",
      "icon.ico",
      "changelog.json",
      "js/**/*",
      "locales/**/*",
      "!node_modules/@fortawesome/fontawesome-free/{js,svgs,sprites,scss,less,metadata}/**",
      "!node_modules/@fortawesome/fontawesome-free/webfonts/*.ttf",
      "!node_modules/@fontsource/inter/files/*.woff",
      "!node_modules/@fontsource/inter/files/*-{100,200,300,800,900}-*",
      "!node_modules/@fontsource/inter/files/*-italic.*",
      "!node_modules/**/*.{md,map,ts}"
    ],
    "electronLanguages": [
      "it",
      "en-US"
    ],
    "portable": {
      "useZip": false
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  }
}
