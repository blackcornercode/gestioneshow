{
  "name": "gestioneshow",
  "version": "2.0.1",
  "description": "Private Diary (Diario Privato): il diario privato degli show",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "screenshot": "node tools/screenshot/esegui.cjs",
    "changelog": "node tools/genera-changelog.cjs",
    "pack": "electron-builder --win --dir --publish never",
    "predist": "npm test",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "keywords": [],
  "author": "The Black Corner <blackcornermail@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "electron-store": "^11.0.2"
  },
  "build": {
    "appId": "com.gestioneshow.app",
    "productName": "Private Diary",
    "copyright": "© 2026 The Black Corner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "index.html",
      "splash.html",
      "style.css",
      "icon.ico",
      "icon-neutra.png",
      "changelog.json",
      "js/**/*",
      "locales/**/*",
      "!node_modules/@fortawesome/fontawesome-free/{js,svgs,sprites,scss,less,metadata}/**",
      "!node_modules/@fortawesome/fontawesome-free/webfonts/*.ttf",
      "!node_modules/@fontsource/inter/files/*.woff",
      "!node_modules/@fontsource/inter/files/*-{100,200,300,800,900}-*",
      "!node_modules/@fontsource/inter/files/*-italic.*",
      "!node_modules/**/*.{md,map,ts}"
    ],
    "electronLanguages": [
      "it",
      "en-US",
      "es",
      "fr",
      "de",
      "pt-BR",
      "pt-PT",
      "ro",
      "ru"
    ],
    "portable": {
      "useZip": false,
      "artifactName": "PrivateDiary-${version}-portable.${ext}",
      "unpackDirName": "PrivateDiary"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "artifactName": "PrivateDiary-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Private Diary",
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "it_IT",
        "en_US",
        "es_ES",
        "fr_FR",
        "de_DE",
        "pt_BR",
        "ru_RU"
      ],
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
